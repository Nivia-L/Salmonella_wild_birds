library(ggtree)
library(ggtreeExtra)
library(ggnewscale)
library(ggplot2)
library(dplyr)
metadata <- read.csv("Supplementary_Table_S1_metadata.csv",
stringsAsFactors = FALSE)
# Armonizar ID problemático
metadata$Isolate_ID[metadata$Isolate_ID == "U2106s (b)"] <- "b"
source_palette <- c(
"Broilers"                = "#1f78b4",
"Layers"                  = "#33a02c",
"Pigs"                    = "#ff7f00",
"Human"                   = "#e31a1c",
"Wild Duck"               = "#b15928",
"Supermarket environment" = "#fdbf6f",
"Wild Bird"               = "#2ca02c"
)
study_palette <- c(
"Wild bird isolates (this study)" = "#2ca02c",
"Broiler isolates"                = "#1f78b4",
"Human isolates"                  = "#e31a1c",
"Environmental isolates"          = "#fdbf6f"
)
n_tips  <- length(tree$tip.label)
n_nodes <- tree$Nnode
edge    <- tree$edge   # matriz [parent, child] en pre-order
# Source y Study de cada punta, en el orden de tree$tip.label
tip_source <- metadata$Source[match(tree$tip.label, metadata$Isolate_ID)]
tip_study  <- metadata$Study[ match(tree$tip.label, metadata$Isolate_ID)]
# Inicializar vector de Source para TODOS los nodos
node_source <- c(tip_source, rep(NA_character_, n_nodes))
# Recorrer aristas de puntas → raíz (invertir pre-order)
for (i in nrow(edge):1) {
parent    <- edge[i, 1]
child     <- edge[i, 2]
child_src <- node_source[child]
par_src   <- node_source[parent]
if (is.na(par_src)) {
node_source[parent] <- child_src          # primera asignación
} else if (!is.na(child_src) && par_src != child_src) {
node_source[parent] <- "Mixed"            # clado con mezcla de fuentes
}
}
node_df <- data.frame(
node   = 1:(n_tips + n_nodes),
Source = node_source,
Study  = c(tip_study,       rep(NA_character_, n_nodes)),
label  = c(tree$tip.label,  rep(NA_character_, n_nodes)),
stringsAsFactors = FALSE
)
p <- ggtree(tree, layout = "circular", linewidth = 0.7) %<+% node_df +
aes(color = Source) +
scale_color_manual(
values   = c(source_palette, "Mixed" = "grey75"),
na.value = "grey85",
guide    = "none"      # la leyenda de ramas se omite (redundante con anillo)
)
p <- p + new_scale_fill()
p <- p +
geom_fruit(
geom    = geom_tile,
mapping = aes(y = label, fill = Study),
width   = 0.08,
offset  = 0.15
) +
scale_fill_manual(
name     = "Study",
values   = study_palette,
na.value = "grey90",
guide    = guide_legend(order = 1)
)
p <- p + new_scale_fill()
p <- p +
geom_fruit(
geom    = geom_tile,
mapping = aes(y = label, fill = Source),
width   = 0.20,
offset  = 0.1
) +
scale_fill_manual(
name     = "Source",
values   = source_palette,
na.value = "grey90",
guide    = guide_legend(order = 2)
)
p <- p +
geom_tippoint(
data    = function(d) subset(d, Study == "Wild bird isolates (this study)"),
mapping = aes(x = x, y = y),
shape   = 17,
size    = 1.8,
color   = "#2ca02c"
)
p <- p +
geom_tiplab(
mapping  = aes(label = label),
size     = 2.5,
offset   = 0.01,
align    = FALSE,
hjust    = 0,
color    = "grey20",
fontface = "bold"
)
# Expandir eje x para que los labels no queden cortados
p <- p + xlim(NA, max(p$data$x, na.rm = TRUE) * 1.4)
p <- p +
theme_void() +
theme(
legend.position    = "right",
legend.title       = element_text(size = 12, face = "bold",
margin = margin(b = 4)),
legend.text        = element_text(size = 11),
legend.key.size    = unit(0.45, "cm"),
legend.spacing.y   = unit(0.15, "cm"),
legend.box.spacing = unit(0.3,  "cm"),
legend.margin      = margin(t = 4, b = 4),
plot.margin        = margin(15, 15, 15, 15)
)
ggsave("Salmonella_fig3.pdf", plot = p,
width = 18, height = 18, units = "cm", device = cairo_pdf)
ggsave("Salmonella_fig3.png", plot = p,
width = 12, height = 12, units = "in", dpi = 600, bg = "white")
print(p)
